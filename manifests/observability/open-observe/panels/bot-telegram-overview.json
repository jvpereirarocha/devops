          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT regexp_match(log, 'event=(\\w+)')[1] AS event,\n       count(*) AS total,\n       sum(CASE WHEN log LIKE '%outcome=error%' THEN 1 ELSE 0 END) AS errors,\n       round(avg(CAST(regexp_match(log, 'duration_ms=(\\d+)')[1] AS BIGINT))) AS avg_ms,\n       approx_percentile_cont(CAST(regexp_match(log, 'duration_ms=(\\d+)')[1] AS BIGINT), 0.95) AS p95_ms\nFROM fintracker_bot\nWHERE log LIKE '%bot.usage: event=%'\nGROUP BY event\nORDER BY total DESC",
